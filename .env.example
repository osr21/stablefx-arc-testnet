# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stablefx

# Required: Express session secret (any random string ≥32 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Platform fee configuration
# Address to receive the platform fee
PLATFORM_FEE_WALLET=
# Fee in basis points (e.g. 20 = 0.20%, 0 = disabled)
PLATFORM_FEE_BPS=0

